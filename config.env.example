# --- Carpetas ---
IN_DIR=./in
OUT_DIR=./out

# --- Certificado PFX ---
PFX_PATH=./12069487-1.pfx
# La clave del PFX NO se guarda aquí: se pasa con --password o se pide de forma interactiva

# --- Ubicación del sello en la página del PDF (en puntos) ---
SIGN_PAGE=last
POS_X=116
POS_Y=139
STAMP_WIDTH=60
STAMP_HEIGHT=14

# --- Imagen de fondo del sello ---
IMAGE_PATH=./firma-template.png

# --- Texto dinámico: nombre del firmante ---
SIGNER_FIRST_NAME=Gonzalo Edgardo
SIGNER_LAST_NAME=Torres Fuchslocher
NAME_FONT_SIZE=16
NAME_POS_X=400
NAME_POS_Y=42

# --- Texto dinámico: fecha de firma ---
DATE_FORMAT=%d-%m-%Y %H:%M:%S
DATE_FONT_SIZE=14
DATE_POS_X=400
DATE_POS_Y=65

# --- Fuente y color de texto (opcionales) ---
FONT_PATH=
TEXT_COLOR=0,0,0

# --- Metadatos de la firma digital (PAdES) ---
SIGN_REASON=Firma electrónica avanzada
SIGN_LOCATION=Servicio de Impuestos Internos
SIGN_CONTACT_INFO=http://www.sii.cl
